---
import BaseLayout from '../layouts/BaseLayout.astro';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';

// Read and parse the ledger markdown
const ledgerPath = path.resolve('./src/content/ledger.md');
const ledgerRaw = fs.readFileSync(ledgerPath, 'utf-8');

marked.setOptions({ gfm: true, breaks: false });
const ledgerHtml = marked(ledgerRaw);
---

<BaseLayout
  title="Software Representation"
  description="A foundational discipline for software development. Software Representation establishes a rigorous framework for enabling software systems to continuously and autonomously represent their own observable structure."
>
  <!-- ============================================================
       SITE HEADER
       ============================================================ -->
  <header class="max-w-3xl mx-auto px-6 sm:px-8 pt-12 pb-6">
    <p class="text-xs font-medium tracking-widest uppercase text-accent dark:text-blue-400">
      A Discipline of Software Development
    </p>
    <h1 class="text-3xl font-semibold mt-1 font-sans">
      Software Representation
    </h1>
  </header>

  <!-- ============================================================
       AUTHOR ATTRIBUTION
       ============================================================ -->
  <div class="max-w-3xl mx-auto px-6 sm:px-8 pb-8 text-sm text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-800">
    <span class="font-medium text-gray-700 dark:text-gray-300">Turner Vickery</span>
    &nbsp;·&nbsp; Software architect and platform engineer
    &nbsp;·&nbsp; Originally published September 2026
  </div>

  <!-- ============================================================
       LEDGER CONTENT
       ============================================================ -->
  <main>
    <article class="prose prose-gray prose-lg dark:prose-invert max-w-3xl mx-auto px-6 sm:px-8 py-16">
      <Fragment set:html={ledgerHtml} />
    </article>
  </main>

  <!-- ============================================================
       TOOL TEASER
       ============================================================ -->
  <div class="max-w-3xl mx-auto px-6 sm:px-8 my-16">
    <div class="border border-gray-200 dark:border-gray-800 rounded-lg p-8 bg-gray-50 dark:bg-gray-900">
      <h2 class="text-lg font-semibold font-sans mb-3">A tool is being built.</h2>
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
        Chomp is an implementation of this framework — an engine that enables software systems
        to continuously and autonomously represent their own structure.
      </p>
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed mt-3">
        It is currently in development and not yet publicly available.
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-4 italic">
        If you are interested in early access or want to follow its progress, leave your email below.
      </p>
    </div>
  </div>

  <!-- ============================================================
       EMAIL CAPTURE
       ============================================================ -->
  <div class="max-w-3xl mx-auto px-6 sm:px-8 my-12">
    <h2 class="text-lg font-semibold font-sans mb-1">Stay informed</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      Get notified when Chomp launches and when new thinking on Software Representation is published.
    </p>

    <form
      action="https://buttondown.com/api/emails/embed-subscribe/YOUR_BUTTONDOWN_USERNAME"
      method="post"
      target="popupwindow"
      class="flex flex-col sm:flex-row gap-3"
    >
      <input
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        class="flex-1 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent dark:focus:ring-blue-500"
      />
      <button
        type="submit"
        class="rounded-md bg-accent dark:bg-blue-600 px-6 py-2.5 text-sm font-medium text-white hover:opacity-90 transition-opacity"
      >
        Notify me
      </button>
    </form>
  </div>

  <!-- ============================================================
       FOOTER
       ============================================================ -->
  <footer class="max-w-3xl mx-auto px-6 sm:px-8 py-12 border-t border-gray-200 dark:border-gray-800">
    <p class="text-xs text-gray-400 dark:text-gray-600">
      © 2026 Turner Vickery &nbsp;·&nbsp; CC BY 4.0 &nbsp;·&nbsp; softwarerepresentation.com
    </p>
  </footer>
</BaseLayout>
